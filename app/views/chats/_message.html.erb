<div class="message <%= message.role %>" id="message-<%= message.id %>">
  <div class="message-role">
    <% if message.role == 'user' %>
      👤 You
    <% else %>
      <% pe = message.prompt_navigator_prompt_execution %>
      🤖 <%= pe&.llm_platform.present? ? PromptNavigator.label_for(platform: pe.llm_platform, model: pe.model) : 'LLM' %>
    <% end %>
  </div>
  <div class="message-content">
    <% if message.role == 'user' %>
      <% img, text = split_attached_image_html(message.prompt_navigator_prompt_execution&.prompt) %>
      <% doc, text = split_attached_document_html(text) %>
      <%= img if img %>
      <%= doc if doc %>
      <%= simple_format(text) %>
    <% else %>
      <%- if message.reasoning.present? -%>
        <%# Collapsed by default: the answer is the point, the reasoning is
            available on demand. Same classes as the live streaming block in
            message_stream_controller.js, minus `thinking-active` (no dots
            once it has finished), so both look identical. %>
        <details class="message-thinking">
          <summary>Reasoning</summary>
          <div class="message-thinking-content"><%= message.reasoning %></div>
        </details>
      <%- end -%>
      <%= assistant_response_markdown(message.prompt_navigator_prompt_execution&.response) %>
    <% end %>
  </div>
</div>
