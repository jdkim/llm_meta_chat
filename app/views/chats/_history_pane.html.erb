<%
  # The history pane, shared by the full page render and the Turbo Stream
  # refresh so the two cannot drift. It uses prompt_navigator's card partial
  # (overridden locally — see app/views/prompt_navigator/_history_card) but
  # not its `_history` wrapper, because the wrapper has no place to put the
  # synthetic root node below.
  chat        = local_assigns[:chat]
  history     = local_assigns[:history] || []
  active_uuid = local_assigns[:active_uuid]
  delete_path = local_assigns[:delete_path]
  parked_at_root = local_assigns[:parked_at_root]

  # A PE is a leaf when nothing else in the chat names it as `previous`.
  non_leaf_ids = history.filter_map(&:previous_id)
%>

<%# The pane's three gestures are not discoverable on their own — clicking a
    node, branching from it, and ctrl-clicking to cite one all look the same
    until you try them. A hover/focus bubble is enough; anything louder would
    sit permanently above a list people use constantly. %>
<h2 class="history-heading">
  History
  <span class="history-help" tabindex="0" role="button"
        aria-label="How to use the history pane" aria-describedby="history-help-bubble">?</span>
  <span class="history-help-bubble" id="history-help-bubble" role="tooltip">
    <span class="history-help-item">
      <strong>Click</strong> a node to revisit that prompt and its answer.
    </span>
    <span class="history-help-item">
      Entering a new prompt from there <strong>branches</strong> the
      conversation at that point.
    </span>
    <span class="history-help-item">
      <strong>Ctrl-click</strong> (⌘-click on a Mac) a node to cite it as a
      <strong>reference</strong> for your next prompt — its question and answer
      travel with that prompt.
    </span>
  </span>
</h2>

<% if chat %>
  <div class="history-stack" id="history-stack" data-controller="history">
    <%# The tree has no record for "before the first prompt", so until this
        existed there was nothing to click to begin a fresh lineage — the
        first prompt was the root by accident of being first. This parks the
        composer at Chat::ROOT_PARENT, which resolve_parent! maps to
        previous_id = nil: a branch with no ancestors, so build_context
        yields no prior turns.

        It is rendered as an ordinary card, and every root names it as
        parent, so the tree has one visible origin instead of several
        unexplained top-level entries. Deliberately neutral wording rather
        than "re-run with another model" — the same prompt on a different
        model and an entirely different prompt are both valid reasons to
        want a clean start. %>
    <div class="history-card history-card-start<%= ' is-active' if parked_at_root %>"
         data-history-target="cards"
         data-uuid="<%= Chat::ROOT_PARENT %>">
      <div class="history-card-row">
        <%= link_to chat_path(chat.uuid, from: Chat::ROOT_PARENT),
                    class: "history-card-link",
                    title: "Compose with no history — starts a new branch from the empty state" do %>
          <div class="history-card-prompt">Start</div>
        <% end %>
      </div>
    </div>
    <%# The gem renders the adjacency arrow *after* a card, so the link from
        Start down to the first root has to be emitted here. Later roots are
        not adjacent to Start and get a curved SVG arrow from history_controller
        instead. %>
    <% if history.first&.previous_id.nil? %>
      <div class="history-straight-arrow">↓</div>
    <% end %>

    <% history.each_with_index do |ann, idx| %>
      <%= render "prompt_navigator/history_card", locals: {
        # A root has no `previous`, so the gem's card would draw no arrow at
        # all. RootLinkedExecution reports the Start node as its parent, which
        # is what makes every root hang off one visible origin.
        ann: ann.previous_id.nil? ? RootLinkedExecution.new(ann) : ann,
        next_ann: history[idx + 1],
        is_active: ann.execution_id == active_uuid,
        card_path: ->(uuid) { prompt_path(uuid) },
        delete_path: delete_path,
        is_leaf: !non_leaf_ids.include?(ann.id)
      } %>
    <% end %>
    <svg class="history-arrows" data-history-target="svg"></svg>
  </div>
<% else %>
  <p class="history-empty">No history yet</p>
<% end %>
