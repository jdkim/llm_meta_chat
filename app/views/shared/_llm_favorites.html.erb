<%
  llm_families = local_assigns[:llm_families] || []
  stimulus_controller = local_assigns[:stimulus_controller]

  favorites = llm_families.flat_map do |fam|
    Array(fam[:api_keys]).flat_map do |key|
      Array(key[:available_models]).select { |m| m["favorite"] }.map do |m|
        {
          family: fam[:llm_type],
          api_key_uuid: key[:uuid],
          meta_id: m["value"],
          label: m["label"]
        }
      end
    end
  end
%>

<% if favorites.any? %>
  <div class="llm-favorites">
    <div class="llm-favorites-header">
      <i class="bi bi-star-fill"></i> Favorites
    </div>
    <div class="llm-favorites-list">
      <% favorites.each do |f| %>
        <button type="button"
                class="llm-favorite-item"
                title="<%= f[:meta_id] %> (<%= f[:family] %>)"
                data-family="<%= f[:family] %>"
                data-api-key-uuid="<%= f[:api_key_uuid] %>"
                data-model="<%= f[:meta_id] %>"
                data-action="click-><%= stimulus_controller %>#selectFavorite">
          <%= f[:label] %>
        </button>
      <% end %>
    </div>
  </div>
<% end %>
