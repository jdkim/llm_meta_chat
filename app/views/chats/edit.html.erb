<% content_for :title, "Chat - LLM Meta Client" %>

<div class="chat-container" data-chat-id="<%= @chat&.id %>">
  <div class="chat-messages" id="chat-messages">
    <div id="messages-list">
      <%= render partial: "chats/messages_list", locals: { messages: @chat&.messages } %>
    </div>
  </div>

  <div class="chat-input-container">
    <%= form_with url: add_prompt_chat_path(@chat.uuid), method: :post, class: "chat-form", data: { controller: "chats-form llm-selector", guest: current_user.nil?, "llm-selector-default-family-value": "ollama", "llm-selector-default-model-value": "qwen3-5-4b", action: "submit->chats-form#submit llm-selector:changed->chats-form#updateSubmitButton dragover->chats-form#onDragOver dragleave->chats-form#onDragLeave drop->chats-form#onDrop" } do |f| %>
      <div class="image-preview" data-chats-form-target="imagePreview" style="display: none;">
        <img data-chats-form-target="imageThumbnail" alt="Attached image preview" />
        <button type="button" class="image-clear-button" title="Remove image"
                data-action="click->chats-form#clearImage">
          <i class="bi bi-x-circle"></i>
        </button>
      </div>
      <div class="input-wrapper">
        <%= f.text_area :message,
            placeholder: "Enter your message...",
            class: "chat-input",
            rows: 2,
            autofocus: true,
            required: true,
            id: "message-input",
            data: { "chats-form-target": "prompt", action: "input->chats-form#updateSubmitButton" } %>
        <button type="button" class="attach-button" disabled
                title="Attach image"
                data-chats-form-target="attachButton"
                data-action="click->chats-form#openImagePicker">
          <i class="bi bi-paperclip"></i>
        </button>
        <%= f.file_field :image, accept: "image/*",
            data: { "chats-form-target": "imageInput",
                    action: "change->chats-form#onImageSelected" },
            style: "display: none;" %>
        <%= f.button type: "submit",
            class: "send-button",
            disabled: true,
            data: {
              "chats-form-target": "submit"
            } do %>
          <i class="bi bi-send-fill"></i>
        <% end %>
      </div>
      <% if @llm_families.present? %>
        <div class="input-controls" data-controller="input-controls">
          <div class="input-controls-buttons">
            <div class="llm-toggle-field" data-controller="llm-toggle">
              <button type="button"
                      class="llm-toggle-button"
                      data-llm-toggle-target="toggleButton"
                      data-action="click->llm-toggle#toggle">
                <i class="bi bi-cpu"></i>
                <span data-llm-toggle-target="label">Select LLM</span>
                <i class="bi bi-chevron-up toggle-icon" data-llm-toggle-target="toggleIcon"></i>
              </button>
              <div class="llm-toggle-panel" data-llm-toggle-target="panel" style="display: none;">
                <%= render "shared/llm_favorites", llm_families: @llm_families, stimulus_controller: "llm-selector" %>
                <div class="llm-selector-wrapper">
                  <%= render "shared/family_field", llm_families: @llm_families, stimulus_controller: "llm-selector" %>
                  <%= render "shared/api_key_field", stimulus_controller: "llm-selector" %>
                  <%= render "shared/model_field", stimulus_controller: "llm-selector" %>
                </div>
              </div>
            </div>
            <% if user_signed_in? %>
              <%= render "shared/tool_selector_field", stimulus_controller: "tool-selector" %>
            <% end %>
            <%= render "shared/generation_settings_field", stimulus_controller: "generation-settings" %>
          </div>
        </div>
      <% end %>
      <%= f.hidden_field :branch_from_uuid, value: @branch_from_uuid || params.dig(:chat, :branch_from_uuid) %>
    <% end %>
  </div>
</div>


<script>
  // Remove previous listener to prevent duplicates across Turbo navigations
  if (window._scrollChatMessages) {
    document.removeEventListener('turbo:load', window._scrollChatMessages);
  }

  window._scrollChatMessages = function() {
    const chatMessages = document.getElementById('chat-messages');
    if (chatMessages) {
      <% if @target_message_id.present? %>
        const targetMessage = document.getElementById('message-<%= @target_message_id %>');
        if (targetMessage) {
          targetMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
          targetMessage.style.backgroundColor = '#fef3c7';
          targetMessage.style.border = '2px solid #fbbf24';
          setTimeout(() => {
            targetMessage.style.transition = 'all 2s ease';
            targetMessage.style.backgroundColor = '';
            targetMessage.style.border = '';
          }, 2000);
        }
      <% else %>
        chatMessages.scrollTop = chatMessages.scrollHeight;
      <% end %>
    }
  };

  document.addEventListener('DOMContentLoaded', window._scrollChatMessages);
  document.addEventListener('turbo:load', window._scrollChatMessages);
</script>
