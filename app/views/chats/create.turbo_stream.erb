<% # Clear the message input %>
<%= turbo_stream.update "message-input" do %>
<% end %>

<% # Remove the landing hero once the first message is in flight — it's a
   # landing-only element and would otherwise linger above the appended
   # messages. Safe when the hero isn't present (Turbo no-ops on missing id). %>
<%= turbo_stream.remove "landing-hero" %>

<% # User message is already shown by JavaScript on form submit %>
<% # Only render assistant message here %>

<%# Render streaming assistant placeholder; the message-stream Stimulus controller opens an EventSource and appends deltas as they arrive. %>
<% if @prompt_execution && @error_message.blank? %>
<%= turbo_stream.append "messages-list" do %>
  <%= render partial: "chats/streaming_message", locals: { chat: @chat, prompt_execution: @prompt_execution } %>
<% end %>
<% end %>

<% # Show error message if any %>
<% if @error_message %>
<%= turbo_stream.append "messages-list" do %>
  <div class="message error">
    <div class="message-content">
      <p><%= @error_message %></p>
    </div>
  </div>
<% end %>
<% end %>

<% # Update chat sidebar %>
<%= turbo_stream.replace "chat-sidebar" do %>
  <%= render partial: "chats/chat_sidebar", locals: { chat: @chat } %>
<% end %>

<% # Reveal/refresh the "New Chat" header button now that the chat has content %>
<%= turbo_stream.replace "new-chat-button-slot" do %>
  <%= render partial: "layouts/new_chat_button" %>
<% end %>

<% # Update history sidebar - replace entire content to ensure update %>
<% if @prompt_execution %>
  <%= turbo_stream.replace "history-sidebar" do %>
    <div id="history-sidebar">
      <%= render "chats/history_pane",
                 chat: @chat,
                 history: (@chat&.ordered_prompt_executions || []),
                 active_uuid: @active_message_uuid,
                 parked_at_root: false,
                 delete_path: (@chat&.read_only_for?(current_user) ? nil : ->(execution_id) { prompt_path(execution_id) }) %>
    </div>
  <% end %>
<% end %>

<% # Clear input, refocus, and scroll %>
<turbo-stream action="after" target="messages-list">
  <template>
    <script>
      (function() {
        // Clear and refocus message input
        const messageInput = document.getElementById('message-input');
        if (messageInput) {
          messageInput.value = '';
          messageInput.focus();
        }

        // Clear the image / document preview boxes + file inputs now that the
        // multipart form has been sent. Doing it in the JS submit handler
        // would empty the file input before the browser serialized the POST body.
        const imagePreview = document.querySelector('[data-chats-form-target="imagePreview"]');
        if (imagePreview) imagePreview.style.display = 'none';
        const imageThumbnail = document.querySelector('[data-chats-form-target="imageThumbnail"]');
        if (imageThumbnail) imageThumbnail.src = '';
        const imageInput = document.querySelector('[data-chats-form-target="imageInput"]');
        if (imageInput) imageInput.value = '';
        const documentPreview = document.querySelector('[data-chats-form-target="documentPreview"]');
        if (documentPreview) documentPreview.style.display = 'none';
        const documentChip = document.querySelector('[data-chats-form-target="documentChip"]');
        if (documentChip) documentChip.textContent = '';
        const documentInput = document.querySelector('[data-chats-form-target="documentInput"]');
        if (documentInput) documentInput.value = '';

        // Update submit button state
        const form = document.querySelector('[data-controller="chats-form"]');
        if (form && messageInput) {
          const event = new Event('input', { bubbles: true });
          messageInput.dispatchEvent(event);
        }

        // Point the composer at the node just created. The server no longer
        // guesses a parent, so a missing field is a real failure rather than
        // something a fallback quietly absorbs — say so instead of passing.
        const parentField = document.getElementById('parent_uuid');
        if (parentField) {
          parentField.value = '<%= @prompt_execution&.execution_id %>';
        } else {
          console.error('parent_uuid field missing; the next prompt will be rejected');
        }

        // Citations were consumed by the prompt just sent. They are a per-turn
        // annotation and are deliberately not inherited by the next one, so
        // clear the selection, its chips, and the card highlighting.
        document.dispatchEvent(new CustomEvent('supplements:reset'));

        // Make this tab's chat identity URL-local so cross-tab navigation
        // can't silently re-target subsequent prompts. After the first POST
        // /chats, swap the URL bar to /chats/<uuid> and point the form at
        // /chats/<uuid>/add_prompt for all subsequent prompts.
        const chatUuid = '<%= @chat&.uuid %>';
        if (chatUuid) {
          const desiredPath = `/chats/${chatUuid}`;
          if (window.location.pathname !== desiredPath) {
            history.replaceState({}, '', desiredPath);
          }
          const chatForm = document.querySelector('.chat-form');
          if (chatForm) {
            chatForm.action = `/chats/${chatUuid}/add_prompt`;
          }
        }

        // Scroll to bottom
        const chatMessages = document.getElementById('chat-messages');
        if (chatMessages) {
          chatMessages.scrollTop = chatMessages.scrollHeight;
        }
      })();
    </script>
  </template>
</turbo-stream>
