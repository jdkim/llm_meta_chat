# /etc/llm_meta_chat.env (mode 0600, owned by pubann)
# Copy to /etc/ with:  sudo install -m 0600 -o pubann -g pubann \
#   config/systemd/llm_meta_chat.env.example /etc/llm_meta_chat.env
# then edit secrets.

RAILS_ENV=production
RAILS_MASTER_KEY=PASTE_CONTENTS_OF_config_master_key_HERE
RAILS_LOG_TO_STDOUT=0

# Puma binds to this port; nginx upstream `chat_app` should point here.
PORT=3001
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2

# Postgres on the same host. Containers aren't involved, so this app can
# connect via the Unix socket (peer auth) by leaving DB_HOST empty.
DB_HOST=
DB_USER=pubann
DB_PASSWORD=
DB_NAME=llm_meta_chat_production

# Google OAuth — same values as your existing .env in dev.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where this app calls the hub (server-side HTTP). Use the loopback
# URL for internal calls so traffic doesn't bounce through the public
# proxy and hit SSE buffering.
LLM_SERVICE_BASE_URL=http://127.0.0.1:5001

# Public URL of the hub — used only for browser-facing links in the
# UI (e.g., "Manage API keys" in the model picker footer). Must be
# something your users' browsers can reach.
LLM_SERVICE_PUBLIC_URL=https://hub.aibranch.org

# Comma-separated emails. Users with one of these emails get access
# to the /admin dashboard. Same allowlist should live in the hub's
# .env.production so super-user status is consistent across services.
SUPER_USER_EMAILS=jindong.kim@gmail.com
